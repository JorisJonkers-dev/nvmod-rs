# Build output
build/
dist/
out/
target/
.gradle/
node_modules/

# Coverage output. REPO_SETUP.md step 4 makes a >=80% coverage gate mandatory,
# so every repo produces these.
coverage/
.nyc_output/
*.lcov

# Build and tool caches
*.tsbuildinfo
.eslintcache

# Package tarballs from `npm pack` / `pnpm pack`
*.tgz

# Vendored CI actions tree: the shared reusable workflows check the github-workflows repo out
# into .github-workflows/ beside the sources. It is CI machinery, not this project's code, so it
# is never committed and is excluded from linting/formatting (antfu-eslint honours .gitignore).
.github-workflows/

# Env / secrets (never commit)
.env
.env.*
!.env.example
*.local

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# Logs
*.log

# Local planning and agent scratch artifacts
.specify/
specs/[0-9][0-9][0-9]-*/
plans/
planning/
scratchpad/
scratchpads/
.agent-council/
**/*scratchpad*.md
**/*.scratch.md
**/*agent-council*.md
.claude/commands/speckit*.md
.claude/skills/speckit*/
.agents/skills/speckit*/

# Agent worktrees. `.claude/worktrees/<name>/` is a full git worktree checked
# out beside the sources; it is machine-local scratch, several MB, and being
# untracked rather than ignored it left this repo permanently dirty.
# Scoped to worktrees/ rather than all of .claude/ so tracked agent config
# elsewhere in the estate is not silently ignored.
.claude/worktrees/

# Python bytecode
__pycache__/
*.py[cod]

# Game data and tool output never enter this repository (docs/clean-room.md, docs/TESTING.md). Fixtures are
# built in memory by tests. scripts/cleanroom_guards.py (task guards) fails the build if one is committed anyway.
*.esm
*.esp
*.esl
*.bsa
*.ba2
*.nif
*.kf
*.dds
*.btr
*.bto
*.btt
*.lod
*.wav
*.ogg
*.mp3
*.fos
*.ess

# Windows binaries and mod archives never enter this repository either: test files are built in code
# (crates/nvmod-testkit). scripts/repo_guards.py (task guards) fails the build if one is committed anyway.
*.dll
*.exe
*.asi
*.7z
*.rar
*.zip

# Run logs a test run can leave in the crate folder.
/crates/nvmod-cli/nvmod/
